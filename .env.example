# Copy to .env and fill in real values locally. Never commit .env.
RUNAI_BASE_URL=https://your-runai-instance.example.edu
RUNAI_CLIENT_ID=your-client-id
RUNAI_CLIENT_SECRET=your-client-secret
RUNAI_VERIFY_TLS=true
# Optional: absolute path to the Cal Poly-issued CA certificate (PEM).
# Keep this file OUTSIDE the repository, e.g. C:/Users/<you>/certs/calpoly-ai-cluster-ca.pem
RUNAI_CA_BUNDLE=
